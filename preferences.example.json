  "substitutions": {
    "_comment": "Two different things. A recipe adaptation is decided up front and reported. An out-of-stock item at basket time stops and asks.",
    "autoAcceptSameProductDifferentBrand": false,
    "adaptRecipesToWhatMereStocks": true
  }
