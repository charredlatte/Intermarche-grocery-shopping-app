  "store": {
    "name": "Intermarché <your town>",
    "address": "<street, postcode town>",
    "phone": "<store phone>",
    "mode": "drive",
    "typicalSlot": "<e.g. afternoon, 12h30–17h30>",
    "url": "https://www.intermarche.com"
  },
  "budget": {
    "ceilingPerOrder": 0,
    "pantryWeekCeiling": 0,
    "currency": "EUR",
    "note": "Ceiling, not a target."
  },
  "dietary": {
    "excluded": [],
    "excludedReason": "",
    "limited": [],
    "limitedReason": "",
    "disliked": [],
    "boredOf": [],
    "alwaysWelcome": []
  },
  "cuisines": {
    "weeklyShare": "most | some | few",
    "preferred": [],
    "notes": "",
    "fallback": ""
  },
  "cooking": {
    "maxWeeknightMinutes": 30,
    "batchCooks": false,
    "batchDay": null,
    "batchNote": "",
    "leftoversNight": null
  },
  "staples": {
